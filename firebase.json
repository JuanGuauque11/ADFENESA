{
  "hosting": [
    {
      "target": "public",
      "public": "FRONTEND",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "backend/**"
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "admin",
      "public": "Admin/files",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "backend/**"
      ],
      "rewrites": [
        { "source": "**", "destination": "/login.html" }
      ]
    }
  ]
}